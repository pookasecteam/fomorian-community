    "variation": "AMB-015",
    "name": "Service Account Authenticating Across Multiple Hosts",
    "description": "Service account svc.monitor logging into multiple servers via SMB in rapid succession - could be monitoring agent or lateral movement",
    "ground_truth": "AMBIGUOUS",
    "legitimate_explanation": "The svc.monitor service account is used by the SolarWinds monitoring agent to perform sequential health checks across all servers. This pattern occurs every 5 minutes and is documented in IT runbooks.",
    "suspicious_explanation": "A compromised service account performing rapid Type 3 logons across multiple hosts within 60 seconds is consistent with lateral movement. Service accounts with broad access are high-value targets for attackers.",
    "expected_detection": "MEDIUM",
    "kill_chain_phase": "lateral-movement",
