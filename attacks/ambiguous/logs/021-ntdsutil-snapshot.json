  "_metadata": {
    "attack_id": "T1003.003",
    "variation": "AMB-021",
    "name": "ntdsutil Creating Active Directory IFM Snapshot",
    "description": "ntdsutil creating Install From Media (IFM) backup of Active Directory - could be legitimate DC upgrade prep or NTDS.dit credential extraction",
    "ground_truth": "AMBIGUOUS",
    "legitimate_explanation": "Domain administrator is preparing an Install From Media (IFM) set for deploying a new domain controller as part of the approved DC02 build-out project. This is standard Microsoft procedure documented in KB4025993.",
    "suspicious_explanation": "ntdsutil IFM creation produces a full copy of NTDS.dit containing all domain password hashes. Attackers extract this file for offline credential cracking with tools like secretsdump.py or mimikatz, compromising every account in the domain.",
    "expected_detection": "MEDIUM",
    "kill_chain_phase": "credential-access",
    "format": "wazuh-native",
    "format_version": "1.0"
  },
