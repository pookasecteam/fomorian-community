    "attack_id": "T1003.001",
    "variation": "AMB-024",
    "name": "Task Manager Creating Process Memory Dump",
    "description": "taskmgr.exe accessing a process with full access rights and creating a dump file - could be IT troubleshooting or credential theft via LSASS dump",
    "ground_truth": "AMBIGUOUS",
    "legitimate_explanation": "IT administrator is troubleshooting a recurring application crash by creating a process memory dump using Task Manager's built-in dump functionality. The dump is saved to the user's temp directory for analysis with WinDbg.",
    "suspicious_explanation": "Task Manager can be used to create a full memory dump of LSASS.exe, which contains plaintext credentials and password hashes. The 0x1F0FFF access mask indicates PROCESS_ALL_ACCESS, and the dump file in temp could contain extractable credentials.",
    "expected_detection": "MEDIUM",
    "kill_chain_phase": "credential-access",
    "format": "wazuh-native",
    "format_version": "1.0"
  },
