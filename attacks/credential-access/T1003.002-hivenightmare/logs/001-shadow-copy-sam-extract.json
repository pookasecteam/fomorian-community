  "_metadata": {
    "attack_id": "T1003.002",
    "variation": "001",
    "name": "HiveNightmare Shadow Copy SAM Extract (CVE-2021-36934)",
    "description": "Non-admin user reads SAM/SYSTEM/SECURITY hives from volume shadow copies due to overly permissive ACLs (HiveNightmare/SeriousSAM). Copied hives are then parsed offline with secretsdump to extract credential hashes.",
    "expected_detection": "HIGH",
    "kill_chain_phase": "credential-access",
    "format": "wazuh-native",
    "format_version": "1.0"
  },
