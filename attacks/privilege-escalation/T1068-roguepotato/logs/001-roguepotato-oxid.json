    "attack_id": "T1068",
    "variation": "001",
    "name": "RoguePotato Fake OXID Resolver to SYSTEM",
    "description": "RoguePotato uses a fake OXID resolver on a remote attacker-controlled host to trick the SYSTEM account into authenticating to a local named pipe. The service account with SeImpersonatePrivilege then impersonates the SYSTEM token. This variant bypasses mitigations that blocked JuicyPotato on Windows Server 2019+.",
    "expected_detection": "HIGH",
    "kill_chain_phase": "privilege-escalation",
    "format": "wazuh-native",
    "format_version": "1.0"
  },
