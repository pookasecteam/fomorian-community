{
  "_metadata": {
    "attack_id": "T1574.010",
    "variation": "001",
    "name": "Service Registry Permissions Weakness - Binary Path Replace",
    "description": "Attacker discovers a service with weak DACL permissions (BUILTIN\\Users has write access), modifies the service binary path using sc.exe to point to a malicious executable, then restarts the service to get SYSTEM execution.",
    "expected_detection": "HIGH",
    "kill_chain_phase": "privilege-escalation",
    "format": "wazuh-native",
    "format_version": "1.0"
  },
